{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": "../../..",
    "paths": {
      "postcss": ["node_modules/postcss/lib/postcss.js"]
    }
  },
  "include": ["src/**/*.ts"]
}
