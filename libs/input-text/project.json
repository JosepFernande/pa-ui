{
  "name": "input-text",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/input-text/src",
  "prefix": "ha",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "dist/{projectRoot}",
        "currentVersionResolver": "git-tag",
        "fallbackCurrentVersionResolver": "disk"
      }
    }
  },
  "tags": ["type:ui"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/input-text/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/input-text/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/input-text/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/input-text/jest.config.cjs"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "stylelint": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "npx stylelint \"{projectRoot}/**/*.css\" --allow-empty-input"
      }
    }
  }
}
