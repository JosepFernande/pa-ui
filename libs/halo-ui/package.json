  "license": "MIT",
  "description": "Accessible, token-driven Angular 19 UI component library — umbrella package",
  "keywords": [
    "angular",
    "angular19",
    "ui-library",
    "halo-ui",
    "component-library",
    "theme-engine",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JosepFernande/halo-ui",
    "directory": "libs/halo-ui"
  },
  "bugs": {
    "url": "https://github.com/JosepFernande/halo-ui/issues"
  },
  "homepage": "https://github.com/JosepFernande/halo-ui#readme",
  "author": "JosepFernande",
  "publishConfig": {
    "access": "public"
  },
  "main": "./index.mjs",
  "types": "./index.d.mts",
